    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const row = item.json;\n  let reqs = [];\n  \n  if (typeof row.requisitos === 'string') {\n    try {\n      reqs = JSON.parse(row.requisitos);\n    } catch (e) {\n      reqs = [row.requisitos];\n    }\n  } else if (Array.isArray(row.requisitos)) {\n    reqs = row.requisitos;\n  } else {\n    reqs = ['Consult official call terms'];\n  }\n\n  return {\n    json: {\n      ...row,\n      requisitos: reqs\n    }\n  };\n});"
      },
